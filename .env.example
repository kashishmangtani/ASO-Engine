# --- Your agency branding (white-label) ---
AGENCY_NAME="Your Agency"
AGENCY_COLOR="#4f46e5"
AGENCY_WEBSITE="https://youragency.com"

# --- AI engines to track. Any engine without a key is skipped. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5
PERPLEXITY_MODEL=sonar
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to use a simulated engine when no keys are set (for demos)
DEMO_MODE=1

# Protect the dashboard (leave blank to disable login)
ADMIN_USER=admin
ADMIN_PASSWORD=
DB_PATH=geo.db

# --- Public landing page ---
AGENCY_EMAIL=hello@youragency.com
# Your Calendly / Cal.com link. If blank, buttons scroll to the contact form.
BOOKING_URL=
CURRENCY=$
